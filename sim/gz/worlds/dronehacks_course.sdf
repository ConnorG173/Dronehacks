<?xml version="1.0" encoding="UTF-8"?>
<!--
  DroneHacks 2026 course (v3) world. World frame == planner map frame (metres, z up, origin = cage centre).
  Course mesh: model://dronehacks_course, generated by sim/tools/step_to_gz.py from the organizers' STEP.
  Lighting: indoor, one overhead key light with shadows so the tunnel interior is dimmer but still trackable.
  Sensor systems (IMU, baro, mag, navsat, rendering) come from PX4's server.config via gz_env.sh.
-->
<sdf version="1.9">
  <world name="dronehacks_course">
    <physics type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>
    <gravity>0 0 -9.8</gravity>
    <!-- Horizontal field along map +x (the spawn heading). PX4 doesn't fuse the compass in this sim
         (sim/px4/4099_gz_skybeta, matching the drone indoors), so this only matters if someone turns it back on. -->
    <magnetic_field>2.3e-05 -6e-06 -4.2e-05</magnetic_field>
    <atmosphere type="adiabatic"/>
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>37.4241</latitude_deg>
      <longitude_deg>-122.1700</longitude_deg>
      <elevation>30</elevation>
    </spherical_coordinates>
    <scene>
      <grid>false</grid>
      <ambient>0.55 0.55 0.55 1</ambient>
      <background>0.35 0.35 0.38 1</background>
      <shadows>true</shadows>
    </scene>

    <light name="key" type="directional">
      <pose>0 0 6 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <diffuse>0.85 0.85 0.82 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <direction>0.15 0.1 -1</direction>
    </light>
    <light name="fill_east" type="point">
      <pose>2.5 0 2.9 0 0 0</pose>
      <cast_shadows>false</cast_shadows>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0 0 0 1</specular>
      <attenuation><range>10</range><constant>0.5</constant><linear>0.05</linear><quadratic>0.01</quadratic></attenuation>
    </light>
    <light name="fill_west" type="point">
      <pose>-2.5 0 2.9 0 0 0</pose>
      <cast_shadows>false</cast_shadows>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0 0 0 1</specular>
      <attenuation><range>10</range><constant>0.5</constant><linear>0.05</linear><quadratic>0.01</quadratic></attenuation>
    </light>

    <include>
      <uri>model://dronehacks_course</uri>
      <name>dronehacks_course</name>
      <pose>0 0 0 0 0 0</pose>
    </include>
  </world>
</sdf>
