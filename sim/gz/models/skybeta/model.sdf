<?xml version="1.0" encoding="UTF-8"?>
<!--
  Sky Beta for Gazebo Harmonic: PX4's x500 airframe + an OAK-D-S2-like stereo pair + a downward
  single-beam rangefinder, approximating drone 12. Topic names match what the organizers'
  sim/skybeta_sim.launch.py expects (namespace "drone", vehicle_id 1), so their stack runs unchanged.

  Approximations (tune as we learn the real drone): x500 mass/inertia/motors (not Sky Beta's),
  camera 1280x800 (their sim launch is hard-wired to it; the drone runs 1024x640), HFOV 80 deg,
  baseline 7.5 cm at x = 0.10 m, ideal pinhole (no distortion), light gaussian image noise.
-->
<sdf version="1.9">
  <model name="skybeta">
    <self_collide>false</self_collide>
    <include merge="true">
      <uri>model://skybeta_frame</uri>  <!-- x500 dynamics, Sky Beta collision footprint (sim/tools/make_skybeta_frame.py) -->
    </include>

    <!-- Downward rangefinder. PX4's gz_bridge reads exactly link "lidar_sensor_link", sensor "lidar". -->
    <link name="lidar_sensor_link">
      <pose relative_to="base_link">0 0 0.02 0 1.5708 0</pose>  <!-- reads ~0.16 m on the floor: above EKF2_MIN_RNG 0.1 like the drone -->
      <inertial>
        <mass>0.001</mass>
        <inertia><ixx>1e-5</ixx><iyy>1e-5</iyy><izz>1e-5</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <sensor name="lidar" type="gpu_lidar">
        <pose>0 0 0 3.1416 0 0</pose>
        <update_rate>50</update_rate>
        <ray>
          <scan>
            <horizontal><samples>1</samples><resolution>1</resolution><min_angle>0</min_angle><max_angle>0</max_angle></horizontal>
            <vertical><samples>1</samples><resolution>1</resolution><min_angle>0</min_angle><max_angle>0</max_angle></vertical>
          </scan>
          <range><min>0.04</min><max>4.0</max><resolution>0.001</resolution></range>
          <noise><type>gaussian</type><mean>0</mean><stddev>0.005</stddev></noise>
        </ray>
        <always_on>1</always_on>
        <visualize>false</visualize>
      </sensor>
    </link>
    <joint name="lidar_sensor_joint" type="fixed">
      <parent>base_link</parent>
      <child>lidar_sensor_link</child>
    </joint>

    <!-- OAK-D-S2-like stereo rig, facing forward. Left camera at +y (FLU). -->
    <link name="oak_link">
      <pose relative_to="base_link">0.10 0 0 0 0 0</pose>
      <inertial>
        <mass>0.06</mass>
        <inertia><ixx>1e-5</ixx><iyy>1e-5</iyy><izz>1e-5</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <visual name="oak_visual">
        <pose>-0.012 0 0 0 0 0</pose>
        <geometry><box><size>0.022 0.11 0.03</size></box></geometry>
        <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
      </visual>
      <sensor name="left" type="camera">
        <pose>0 0.0375 0 0 0 0</pose>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <topic>/drone1/left/color/image_raw</topic>
        <gz_frame_id>left</gz_frame_id>
        <camera name="left">
          <horizontal_fov>1.3963</horizontal_fov>
          <image><width>1280</width><height>800</height><format>R8G8B8</format></image>
          <clip><near>0.05</near><far>40</far></clip>
          <camera_info_topic>/drone1/left/color/camera_info</camera_info_topic>
          <noise><type>gaussian</type><mean>0</mean><stddev>0.007</stddev></noise>
        </camera>
      </sensor>
      <sensor name="right" type="camera">
        <pose>0 -0.0375 0 0 0 0</pose>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <topic>/drone1/right/color/image_raw</topic>
        <gz_frame_id>right</gz_frame_id>
        <camera name="right">
          <horizontal_fov>1.3963</horizontal_fov>
          <image><width>1280</width><height>800</height><format>R8G8B8</format></image>
          <clip><near>0.05</near><far>40</far></clip>
          <camera_info_topic>/drone1/right/color/camera_info</camera_info_topic>
          <noise><type>gaussian</type><mean>0</mean><stddev>0.007</stddev></noise>
        </camera>
      </sensor>
    </link>
    <joint name="oak_joint" type="fixed">
      <parent>base_link</parent>
      <child>oak_link</child>
    </joint>

    <!-- Ground truth for evaluation only. Topic names deliberately avoid /model/<name>/odometry_with_covariance,
         which PX4's gz_bridge would feed to EKF2 as perfect external vision. -->
    <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
      <odom_frame>course</odom_frame>  <!-- ground truth is in our course frame (cuVSLAM owns "map") -->
      <robot_base_frame>base_link</robot_base_frame>
      <odom_topic>/sim/ground_truth/odom</odom_topic>
      <odom_covariance_topic>/sim/ground_truth/odom_with_covariance</odom_covariance_topic>
      <tf_topic>/sim/ground_truth/tf</tf_topic>
      <odom_publish_frequency>100</odom_publish_frequency>
      <dimensions>3</dimensions>
    </plugin>
  </model>
</sdf>
