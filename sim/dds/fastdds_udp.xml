<?xml version="1.0" encoding="UTF-8" ?>
<!--
  UDP-only Fast DDS profile for the sim. The stack container runs as root and our host processes as the
  VM user; Fast DDS shared-memory segments created by root are not writable by the host user, so host ->
  container data silently never arrives (discovery still works over UDP). Disabling SHM fixes it.
  Used by sim/scripts/common.sh (host side) and passed into the stack container.
-->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>udp_only</transport_id>
      <type>UDPv4</type>
      <sendBufferSize>33554432</sendBufferSize>
      <receiveBufferSize>33554432</receiveBufferSize>
    </transport_descriptor>
  </transport_descriptors>
  <participant profile_name="udp_only_participant" is_default_profile="true">
    <rtps>
      <userTransports><transport_id>udp_only</transport_id></userTransports>
      <useBuiltinTransports>false</useBuiltinTransports>
    </rtps>
  </participant>
</profiles>
